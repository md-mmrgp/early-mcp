# Copier en .env (ignoré par git) et remplir. Ne jamais commiter les vraies valeurs.
# Clé et secret créés sur product.early.app (le secret n'est affiché qu'une fois).
EARLY_API_KEY=
EARLY_API_SECRET=

# --- Mode hébergé (HTTP) uniquement ---
# Jeton secret que le client MCP enverra (Authorization: Bearer ...). 32 caractères minimum.
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Nom de domaine public du serveur (protection Host/Origin).
MCP_PUBLIC_HOST=
